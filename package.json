{
  "name": "relay-manager",
  "version": "3.0.0",
  "description": "Relay Manager: consolas serie, placas de relés Devantech y accesos de red compartidos para un banco de equipos",
  "author": "Alejandro Avila Marcos",
  "contributors": [
    "Jose Duro Gómez"
  ],
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "RM_DEV=1 tsx server.ts",
    "dev:sim": "node scripts/sim/dev-sim.mjs",
    "dev:seed": "node scripts/dev-seed.mjs",
    "sim": "node scripts/sim/bench.mjs",
    "sim:relays": "node scripts/sim/bench.mjs --only relays",
    "sim:consoles": "node scripts/sim/bench.mjs --only consoles",
    "build": "prisma generate && next build && node scripts/esbuild.server.mjs",
    "start": "RM_MODE=portable RM_APP_DIR=. RM_DATA_DIR=.data RM_CONFIG=./config.env node build/server.js start",
    "bundle": "bash scripts/build-bundle.sh",
    "image": "bash scripts/build-bundle.sh --skip-tests --docker",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e/smoke.mjs",
    "test:bundle": "bash scripts/test-bundle.sh",
    "test:net": "bash scripts/nettest/run.sh",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:new": "prisma migrate dev --create-only --name",
    "db:check": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "doctor": "RM_DEV=1 tsx server.ts doctor",
    "fonts:vendor": "bash scripts/vendor-fonts.sh"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.0.1",
    "@prisma/client": "7.0.1",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.7",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-search": "0.15.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "5.5.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "12.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "^0.555.0",
    "next": "16.0.6",
    "next-auth": "5.0.0-beta.30",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-resizable-panels": "^3.0.6",
    "serialport": "13.0.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "ssh2": "1.17.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "ws": "8.18.3",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2": "1.15.6",
    "@types/ws": "^8.18.1",
    "esbuild": "0.27.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.6",
    "playwright-core": "1.63.0",
    "prisma": "7.0.1",
    "tailwindcss": "4.1.17",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
