# Perfil de ejemplo de Relay Manager: valores por defecto de un proyecto.
# Precedencia: entorno del proceso > config.env > este fichero > valores genéricos del programa.
# Solo se admiten las variables de abajo (las demás se ignoran con un aviso). Las rutas relativas
# (RM_EXPORT_DOWNLOADER) son relativas a la carpeta del perfil. Más detalle: docs/PERFIL.md.

# Nombre del laboratorio al crear la base de datos (una base de datos existente conserva el suyo).
RM_LAB_NAME="Laboratorio de ejemplo"

# Segunda carpeta compartida de Archivos (sin RM_FILES_EXTRA_NAME no existe).
# ~ es la carpeta personal de quien ejecuta la aplicación (install.sh usa la de quien instala).
RM_FILES_EXTRA_NAME=Compartida
RM_FILES_EXTRA_DIR=~/compartida
RM_FILES_EXTRA_HINT="Segunda carpeta compartida (~/compartida)"

# «Descargas»: ejecuta un script del perfil con <aplicación> <versión> -o <salida.zip> [-x]
# y deja el .zip en la carpeta elegida (RM_EXPORT_ROOT: extra o tftp).
RM_EXPORT_ENABLED=1
RM_EXPORT_DOWNLOADER=herramientas/descarga-ejemplo.sh
RM_EXPORT_ROOT=extra
RM_EXPORT_NAME=Descargas
RM_EXPORT_TITLE="Ejecutar script de descarga…"
RM_EXPORT_DESCRIPTION="El servidor ejecuta el script de ejemplo, que crea un .zip pequeño con la aplicación y la versión indicadas."
RM_EXPORT_APP_LABEL=Aplicación
RM_EXPORT_VERSION_LABEL=Versión
RM_EXPORT_EXTRACT_LABEL="Añadir un fichero extra (opción -x)"
# RM_EXPORT_URL=http://repositorio.example:8082/artefactos
# Nombres de las variables con las que el script recibe usuario, contraseña y URL (por defecto EXPORT_USER,
# EXPORT_PASSWORD y EXPORT_URL) y variables fijas para sus herramientas:
# RM_EXPORT_ENV_USER=REPO_USER
# RM_EXPORT_ENV_PASSWORD=REPO_PASSWORD
# RM_EXPORT_ENV_URL=REPO_URL
# RM_EXPORT_ENV_EXTRA="HERRAMIENTA_SIN_PREGUNTAS=true"

# Red de equipos: la IP que tienen todos los equipos y el puerto SSH de los accesos Ethernet nuevos.
RM_EQUIPNET_EQUIPMENT_IP=192.168.1.10
RM_EQUIPNET_EQUIPMENT_PORT=22
