{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relay-manager.local/plantilla.schema.json",
  "title": "Plantilla de equipo de Relay Manager (<perfil>/plantillas/*.json)",
  "description": "Una plantilla por fichero. «key» es su identidad estable; el resto se copia al crear cada equipo. Generado desde src/lib/contracts/template-file.ts.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "description": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "needsReview": {
      "default": false,
      "type": "boolean"
    },
    "position": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    },
    "namePattern": {
      "default": "{template} #{nn}",
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "skipInterfaces": {
      "default": [],
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 15
      }
    },
    "consoles": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,23}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "line": {
            "type": "object",
            "properties": {
              "baudRate": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "dataBits": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 5
                  },
                  {
                    "type": "number",
                    "const": 6
                  },
                  {
                    "type": "number",
                    "const": 7
                  },
                  {
                    "type": "number",
                    "const": 8
                  }
                ]
              },
              "parity": {
                "type": "string",
                "enum": [
                  "none",
                  "even",
                  "odd",
                  "mark",
                  "space"
                ]
              },
              "stopBits": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 1
                  },
                  {
                    "type": "number",
                    "const": 2
                  }
                ]
              },
              "flowControl": {
                "type": "string",
                "enum": [
                  "none",
                  "rtscts",
                  "xonxoff"
                ]
              }
            },
            "required": [
              "baudRate",
              "dataBits",
              "parity",
              "stopBits",
              "flowControl"
            ]
          },
          "enterMode": {
            "default": "cr",
            "type": "string",
            "enum": [
              "cr",
              "lf",
              "crlf"
            ]
          },
          "localEcho": {
            "default": false,
            "type": "boolean"
          },
          "identify": {
            "default": {},
            "type": "object",
            "properties": {
              "hostnameRegex": {
                "type": "string",
                "maxLength": 200
              },
              "bannerRegex": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        },
        "required": [
          "key",
          "label",
          "line"
        ]
      }
    },
    "relays": {
      "default": [],
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,23}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "purpose": {
            "default": "generic",
            "type": "string",
            "enum": [
              "power",
              "reset",
              "mode",
              "generic"
            ]
          },
          "requireConfirm": {
            "default": false,
            "type": "boolean"
          },
          "defaultPulseMs": {
            "default": null,
            "anyOf": [
              {
                "type": "integer",
                "minimum": 19,
                "maximum": 60000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "key",
          "label"
        ]
      }
    },
    "accesses": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,23}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "kind": {
            "type": "string",
            "enum": [
              "jtag",
              "serial",
              "tcp"
            ]
          },
          "policy": {
            "default": "reserved",
            "type": "string",
            "enum": [
              "reserved",
              "always"
            ]
          },
          "consoleKey": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,23}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "targetHost": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "maxLength": 253
              },
              {
                "type": "null"
              }
            ]
          },
          "targetPort": {
            "default": null,
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              {
                "type": "null"
              }
            ]
          },
          "cableName": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[\\p{L}\\p{N}][\\p{L}\\p{N} ._#/-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "targetMode": {
            "type": "string",
            "enum": [
              "switch",
              "ip"
            ]
          },
          "sshUser": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "key",
          "label",
          "kind"
        ]
      }
    }
  },
  "required": [
    "key",
    "name",
    "consoles"
  ],
  "additionalProperties": false
}
