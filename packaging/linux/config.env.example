# Configuración de Relay Manager.
#
# Servicio: /etc/relay-manager/config.env (root:relay-manager, permisos 0640).
# Modo portátil: config.env junto a bin/ y app/ en la carpeta del paquete.
# Docker: /data/config.env dentro del volumen.
#
# Todo es opcional: sin este fichero se usan los valores por defecto indicados.
# Formato KEY=valor, una variable por línea; las líneas con # se ignoran.
# Precedencia: variables de entorno del proceso > este fichero > perfil.env del perfil > valores por defecto.
# Los valores propios de cada proyecto (nombre del laboratorio, segunda carpeta de Archivos, script de descarga,
# IP de los equipos…) viven en el perfil (perfil.env); aquí solo hace falta lo que cambia en este equipo.
# Tras cambiar algo: sudo systemctl restart relay-manager
# Comprueba el resultado con: sudo relay-manager doctor

# --- Red --------------------------------------------------------------------
# Dirección en la que escucha el servidor (0.0.0.0 = todas las interfaces IPv4).
#RM_HOST=0.0.0.0
# Puerto HTTP(S) de la interfaz web, SSE y consolas (WebSocket). 1024 o superior.
#RM_PORT=3200
# HTTPS: ambas o ninguna. install.sh --tls-selfsigned las rellena.
#RM_TLS_CERT=/etc/relay-manager/tls/cert.pem
#RM_TLS_KEY=/etc/relay-manager/tls/key.pem

# --- Perfil del proyecto ------------------------------------------------------
# Carpeta del perfil: perfil.env (valores del proyecto), plantillas/*.json (plantillas de equipo, de solo lectura en la
# web), herramientas/ (p. ej. el script de descarga) y manuales/. Por defecto: servicio → /etc/relay-manager/perfil
# (lo instala sudo ./install.sh --perfil <carpeta>); portátil → perfil/ junto a bin/ y app/; Docker → /perfil.
# Sin perfil se usan los valores genéricos. Tras cambiar las plantillas: relay-manager plantillas recargar (o el
# botón «Recargar plantillas»); tras cambiar perfil.env: reinicia el servicio. Solo aquí o en el entorno, nunca en perfil.env.
#RM_PROFILE_DIR=/etc/relay-manager/perfil
# Las variables del perfil también se pueden poner aquí, y aquí mandan sobre perfil.env: RM_LAB_NAME, RM_FILES_EXTRA_*,
# RM_EXPORT_* (también RM_EXPORT_USER, RM_EXPORT_PASSWORD, RM_EXPORT_URL y RM_EXPORT_ENV_*), RM_EQUIPNET_EQUIPMENT_IP,
# RM_EQUIPNET_EQUIPMENT_PORT.
# Nombre del laboratorio al crear la base de datos (después se cambia en Sistema). Por defecto, «Relay Manager».
#RM_LAB_NAME=

# --- Datos ------------------------------------------------------------------
# Directorio de datos (base de datos, secreto, copias, capturas). Si lo mueves fuera de
# /var/lib/relay-manager, el servicio necesita un drop-in con ReadWritePaths= (INSTALACION.md, apartado 13).
#RM_DATA_DIR=/var/lib/relay-manager
#RM_DB_FILE=/var/lib/relay-manager/relay-manager.db
#RM_BACKUP_DIR=/var/lib/relay-manager/backups
#RM_CAPTURE_DIR=/var/lib/relay-manager/consoles
# 1 = arrancar aunque la base de datos tenga migraciones de una versión más nueva (no recomendado).
#RM_ALLOW_UNKNOWN_MIGRATIONS=0

# --- Sesiones y acceso ------------------------------------------------------
# Secreto de las sesiones (32 caracteres o más). Por defecto se genera solo en <datos>/auth-secret.
#RM_AUTH_SECRET=
# Caducidad de la sesión por inactividad, en horas (1 a 168). El máximo absoluto es 72 h.
#RM_SESSION_MAX_AGE_H=12
# Código fijo de configuración inicial (automatización). Por defecto se genera uno aleatorio.
#RM_SETUP_TOKEN=
# Nivel de registro: debug, info, warn o error.
#RM_LOG_LEVEL=info
# 1 = permitir el modo portátil como root (solo pruebas en contenedores).
#RM_ALLOW_ROOT=0

# --- Consolas serie -----------------------------------------------------------
# Raíz de /dev (Docker: /hostdev) y de /sys (pruebas).
#RM_SERIAL_DEV_ROOT=/dev
#RM_SERIAL_SYS_ROOT=/sys
# Rutas extra (lista separada por comas, comodines solo en el último componente), p. ej. los
# simuladores: /run/relay-manager/sim/ttyV*
#RM_SERIAL_EXTRA_GLOBS=
# 1 = listar también los puertos serie integrados (ttyS*, ttyAMA*).
#RM_SERIAL_INCLUDE_BUILTIN=0
# 1 = ocultar en los selectores los puertos que parecen JTAG.
#RM_SERIAL_HIDE_JTAG=1
# Sondeo de adaptadores (500 a 60000 ms) y tiempo de estabilización al conectar (0 a 10000 ms).
#RM_SERIAL_SCAN_INTERVAL_MS=2000
#RM_SERIAL_SETTLE_MS=800
# 0 = quitar la acción «Enviar retorno de carro» de Descubrimiento.
#RM_SERIAL_ALLOW_POKE=1
# Historial en memoria por consola, en KiB (16 a 4096).
#RM_SERIAL_HISTORY_KB=256
# 0 = no guardar capturas de consola en disco.
#RM_CAPTURE_ENABLED=1

# --- Accesos de red (JTAG, consolas serie por TCP, Ethernet) ------------------
# Rango de puertos TCP fijos de los accesos de los equipos (uno por acceso). El puerto de la
# interfaz web (RM_PORT) nunca se usa aunque esté dentro. Como mucho 1000 puertos.
#RM_ACCESS_PORTS=3201-3230
# Dirección en la que escuchan los accesos (0.0.0.0 = todas las interfaces IPv4).
#RM_ACCESS_BIND=0.0.0.0
# Conexiones simultáneas por acceso (consolas serie y Ethernet), de 1 a 64.
#RM_ACCESS_MAX_CONNECTIONS=8
# Ruta de hw_server (Vivado Lab, Vivado o Vitis). Sin definir se busca en XSCT, VITIS, XILINX_VITIS,
# XILINX_VIVADO, el PATH y /tools/Xilinx, /opt/Xilinx, ~/Xilinx (la versión más nueva).
#RM_HW_SERVER=/tools/Xilinx/Vivado_Lab/2024.2/bin/hw_server
# Valor de "set jtag-port-filter" de cada hw_server. {serial} es el número de serie del cable (el de sysfs) y
# {vendor} es Digilent o Xilinx. hw_server acepta identificadores parciales, así que basta el número de serie;
# si "jtag targets" en xsdb no muestra el cable, prueba {vendor}/{serial}.
#RM_HW_SERVER_FILTER_FORMAT={serial}
# Raíz de sysfs para detectar los cables JTAG (pruebas y simulador). Por defecto, la de RM_SERIAL_SYS_ROOT.
#RM_JTAG_SYS_ROOT=/sys

# --- Archivos (intercambio de ficheros con los PC) ------------------------------
# Carpeta del servidor que la página «Archivos» deja subir y descargar a todos los usuarios con sesión.
# Por defecto: servicio → la que escribe install.sh (la carpeta tftp del usuario que lo ejecutó con sudo, p. ej.
# /home/<usuario>/tftp, o /var/lib/relay-manager/tftp); portátil y desarrollo → ~/tftp del usuario que lo arranca;
# Docker → /files (monta ahí la carpeta del anfitrión). Para cambiarla en el servicio usa
# sudo /opt/relay-manager/current/install.sh --files-dir <ruta> --yes (ajusta permisos y el acceso de systemd).
#RM_FILES_DIR=
# 0 = quitar la página Archivos y su API.
#RM_FILES_ENABLED=1
# Tamaño máximo de cada archivo subido, en MiB (1 a 1048576).
#RM_FILES_MAX_UPLOAD_MB=4096
# Quién puede borrar: users (cualquier usuario con sesión, queda en la auditoría) o admins.
#RM_FILES_DELETE=users
# Segunda carpeta de Archivos (raíz «extra»): solo existe si tiene nombre (RM_FILES_EXTRA_NAME, normalmente en el
# perfil). Su carpeta por defecto: servicio → la que escribe install.sh (RM_FILES_EXTRA_DIR del perfil, con «~» = el
# usuario que lo ejecutó con sudo, o /var/lib/relay-manager/<nombre>); portátil y desarrollo → ~/<nombre>; Docker →
# /extra. Para cambiarla en el servicio: sudo /opt/relay-manager/current/install.sh --extra-dir <ruta> --yes.
# No puede ser la de RM_FILES_DIR ni estar dentro.
#RM_FILES_EXTRA_NAME=
#RM_FILES_EXTRA_DIR=
# Descripción de una línea en el selector de carpetas. Por defecto, «Segunda carpeta compartida (<carpeta>)».
#RM_FILES_EXTRA_HINT=
# 0 = sin la segunda carpeta aunque el perfil le dé nombre.
#RM_FILES_EXTRA_ENABLED=1

# --- Archivos › Script de descarga del perfil -----------------------------------
# Cualquier usuario con sesión lanza el script del perfil, que deja un .zip en la carpeta de Archivos:
#   bash <script> <aplicación> <versión> -o <salida.zip> [-x]
# Una descarga a la vez en el servidor; las demás esperan en cola. Normalmente se activa en el perfil (perfil.env).
# 1 = mostrar la opción (por defecto 0).
#RM_EXPORT_ENABLED=0
# Ruta del script; si es relativa, respecto a la carpeta del perfil (p. ej. herramientas/descarga.sh).
#RM_EXPORT_DOWNLOADER=
# Tiempo máximo de una descarga, en minutos (1 a 1440); después se cancela.
#RM_EXPORT_TIMEOUT_MIN=60
# Dónde deja el .zip: extra (la segunda carpeta, si existe) o tftp.
#RM_EXPORT_ROOT=
# Textos de la web: nombre corto, título del botón y del diálogo, párrafo explicativo, etiquetas de los campos y de la
# casilla opcional «-x» (sin RM_EXPORT_EXTRACT_LABEL, la casilla no aparece).
#RM_EXPORT_NAME=Descargas
#RM_EXPORT_TITLE=
#RM_EXPORT_DESCRIPTION=
#RM_EXPORT_APP_LABEL=Aplicación
#RM_EXPORT_VERSION_LABEL=Versión
#RM_EXPORT_EXTRACT_LABEL=
# Credenciales del repositorio de artefactos que se pasan al script (por defecto como EXPORT_USER y EXPORT_PASSWORD;
# el perfil elige los nombres con RM_EXPORT_ENV_USER / RM_EXPORT_ENV_PASSWORD). La contraseña solo vive en este fichero
# o en el perfil (root:relay-manager 0640): nunca se envía al navegador ni aparece en el registro ni en la auditoría.
#RM_EXPORT_USER=
#RM_EXPORT_PASSWORD=
# Dirección del repositorio de artefactos que se pasa al script (por defecto como EXPORT_URL; RM_EXPORT_ENV_URL) y que
# Salud/doctor comprueba si responde. La unidad del servicio no limita las conexiones salientes (no hay IPAddressDeny).
#RM_EXPORT_URL=

# --- Archivos › Copiar a una carpeta del servidor (solo administradores) ------
# 0 = quitar la opción (la web y la API; el ayudante de root también la rechaza).
#RM_COPY_ENABLED=1
# Carpetas que se pueden recorrer y en las que se puede copiar, separadas por comas (por defecto, todo el sistema: /).
#RM_COPY_ROOTS=/
# Carpetas donde nunca se copia, además de las del sistema (/etc, /usr, /boot, /proc, /sys, /dev, /run salvo
# /run/media, /bin, /sbin, /lib*) y las de Relay Manager, que siempre están prohibidas.
#RM_COPY_DENY=
# «Copiar como administrador (sudo)»: carpetas donde el ayudante de root puede escribir (pendrives y montajes a mano).
# Tras cambiarlo, vuelve a ejecutar sudo /opt/relay-manager/current/install.sh --yes (ajusta el ayudante y systemd).
#RM_COPY_ROOT_PATHS=/media,/run/media,/mnt
# Usuario con sudo cuya contraseña autoriza la copia como administrador. Lo escribe install.sh (quien lo ejecutó con
# sudo); para cambiarlo: sudo /opt/relay-manager/current/install.sh --sudo-user <usuario> --yes
#RM_SUDO_USER=
# Grupos que dan permiso de administrador en este equipo (sudo en Debian y Ubuntu, wheel en otros).
#RM_COPY_SUDO_GROUPS=sudo,wheel,admin
# «Montar» y «Expulsar» pendrives (en el mismo diálogo) usan esa misma contraseña: el ayudante de montaje
# (relay-manager-rootmount) monta en /media/<RM_SUDO_USER>/<etiqueta>. Solo dispositivos extraíbles o USB, nunca
# los discos del sistema. Tras escribir la contraseña, la sesión del navegador la recuerda 5 minutos.
# Solo para pruebas: un /dev/loopN que la lista de unidades trata como extraíble (nunca en un banco de verdad).
#RM_COPY_TEST_REMOVABLE=

# --- Red de equipos (switch de los equipos y adaptador USB) --------------------
# apply = el servicio prepara sus interfaces VLAN (rmv*), direcciones y rutas propias en el adaptador USB elegido
# (necesita CAP_NET_ADMIN, que la unidad systemd ya tiene); off = nunca cambia la red del servidor y la web solo
# muestra las órdenes «ip» para ejecutarlas como root. La red del laboratorio no se toca en ningún caso.
#RM_NET_HOST=apply
# Raíz de sysfs para detectar los adaptadores de red (pruebas y simuladores). Por defecto, la de RM_SERIAL_SYS_ROOT.
#RM_NET_SYS_ROOT=/sys
# Ruta de la orden ip (por defecto /usr/sbin/ip, /sbin/ip, /usr/bin/ip o /bin/ip).
#RM_NET_IP_BIN=
# 1 = permitir un adaptador que no es USB (la tarjeta con la ruta por defecto nunca se permite).
#RM_NET_ALLOW_NON_USB=0
# Puerto HTTP de la gestión del switch (solo simuladores).
#RM_NET_SWITCH_HTTP_PORT=80
# Lectura del enlace de los puertos del switch (2000 a 300000 ms).
#RM_NET_POLL_MS=10000
# IP inicial de «IP de los equipos» al crear la configuración de la red de equipos (después se cambia en la web).
#RM_EQUIPNET_EQUIPMENT_IP=
# Puerto de los accesos Ethernet nuevos y de «Enviar a equipo» cuando el acceso no tiene uno.
#RM_EQUIPNET_EQUIPMENT_PORT=22

# --- Placas de relés ----------------------------------------------------------
# Sondeo de placas en línea (1000 a 60000 ms) y sin conexión (5000 a 300000 ms).
#RM_RELAY_POLL_MS=5000
#RM_RELAY_OFFLINE_POLL_MS=15000
# Tiempo máximo por petición a una placa (200 a 10000 ms).
#RM_RELAY_TIMEOUT_MS=1500
# 0 = no escuchar los anuncios UDP 30303 de las placas.
#RM_RELAY_PASSIVE_DISCOVERY=1
# Puerto UDP de descubrimiento (solo pruebas).
#RM_RELAY_DISCOVERY_PORT=30303
# Direcciones de difusión para «Buscar placas (UDP)», separadas por comas (por defecto, las de cada interfaz).
#RM_RELAY_DISCOVERY_BROADCASTS=
# Redes para el barrido HTTP/TCP, separadas por comas, cada una /22 o menor (por defecto, la /24 de cada interfaz).
#RM_RELAY_SCAN_CIDRS=
# Puertos del barrido (hasta 4, separados por comas).
#RM_RELAY_SCAN_PORTS=80
# 1 = permitir el controlador «simulated» (demostraciones sin hardware).
#RM_RELAY_SIMULATE=0

# --- Solo en el entorno del proceso -------------------------------------------
# RM_MODE, RM_DEV, RM_CONFIG y RM_APP_DIR se deciden antes de leer este fichero: aquí se ignoran.
# El servicio y el lanzador (relay-manager) ya los fijan.
#RM_MODE=native
#RM_DEV=0
#RM_CONFIG=/etc/relay-manager/config.env
#RM_APP_DIR=/opt/relay-manager/current/app
